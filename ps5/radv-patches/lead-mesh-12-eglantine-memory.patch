EglantinePS5's RADV memory fixes (its tools/patch-radv-wsi.py DRIVER_ADAPTATIONS), carried by
~/longshot/ps5/scripts/radv_eg_port.py:
- the winsys takes 16 KiB pieces when no large one is free (EDEN_RADV_FINE_PIECES=0: off)
- a command buffer's upload buffer that stays mostly unused is given back at reset (EDEN_RADV_UPLOAD_TRIM_KIB=<n>)
- a shader arena that cannot be made fails the shader instead of the process; a compute pipeline whose shader
  did not upload is not built
Longshot ran out of direct memory 9 min in on 2026-11-18 with 120 MiB free in 323 pieces, none over 4 MiB.

diff -ruN a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
--- a/src/amd/vulkan/radv_cmd_buffer.c	2026-11-18 11:33:12.881972617 +0000
+++ b/src/amd/vulkan/radv_cmd_buffer.c	2026-11-18 11:26:01.254035479 +0000
@@ -1324,6 +1324,33 @@
    memset(&cmd_buffer->state.render, 0, sizeof(cmd_buffer->state.render));
 }
 
+#include <stdlib.h>
+
+static void
+eden_upload_trim(struct radv_cmd_buffer *cmd_buffer)
+{
+   static int64_t limit = -1;
+   if (limit < 0) {
+      const char *const value = getenv("EDEN_RADV_UPLOAD_TRIM_KIB");
+      limit = value ? (int64_t)strtoull(value, NULL, 10) << 10 : 0;
+   }
+   if (!limit || !cmd_buffer->upload.upload_bo)
+      return;
+   if (cmd_buffer->upload.size <= (uint64_t)limit || (uint64_t)cmd_buffer->upload.offset * 4 >= cmd_buffer->upload.size) {
+      cmd_buffer->upload.small_recordings = 0;
+      return;
+   }
+   if (++cmd_buffer->upload.small_recordings < 64)
+      return;
+   struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
+   radv_rmv_log_command_buffer_bo_destroy(device, cmd_buffer->upload.upload_bo);
+   radv_bo_destroy(device, &cmd_buffer->vk.base, cmd_buffer->upload.upload_bo);
+   cmd_buffer->upload.upload_bo = NULL;
+   cmd_buffer->upload.map = NULL;
+   cmd_buffer->upload.size = 0;
+   cmd_buffer->upload.small_recordings = 0;
+}
+
 static void
 radv_reset_cmd_buffer(struct vk_command_buffer *vk_cmd_buffer, UNUSED VkCommandBufferResetFlags flags)
 {
@@ -1371,6 +1398,7 @@
    memset(&cmd_buffer->queue_state, 0, sizeof(cmd_buffer->queue_state));
    memset(&cmd_buffer->state, 0, sizeof(cmd_buffer->state));
 
+   eden_upload_trim(cmd_buffer);
    if (cmd_buffer->upload.upload_bo)
       radv_cs_add_buffer(device->ws, cs->b, cmd_buffer->upload.upload_bo);
    cmd_buffer->upload.offset = 0;
