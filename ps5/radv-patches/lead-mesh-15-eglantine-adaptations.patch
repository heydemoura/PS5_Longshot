 static void
+eden_dispatch_scratch(struct radv_cmd_buffer *cmd_buffer, struct radv_cmd_stream *cs,
+                      const struct radv_shader *shader)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *const value = getenv("EDEN_RADV_DISPATCH_SCRATCH");
+      p_atomic_set(&enabled, value && value[0] == '1');
+   }
+   const uint32_t need = shader->config.scratch_bytes_per_wave;
+   if (!enabled || !need)
+      return;
+   struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   static simple_mtx_t lock = SIMPLE_MTX_INITIALIZER;
+   static struct radeon_winsys_bo *bo;
+   static uint32_t bo_wave_bytes, bo_waves;
+   simple_mtx_lock(&lock);
+   if (need > bo_wave_bytes) {
+      const uint32_t wave_bytes = MAX2(align(need, pdev->info.scratch_wavesize_granularity), 16384u);
+      const uint32_t waves = pdev->info.max_scratch_waves;
+      struct radeon_winsys_bo *grown = NULL;
+      if (radv_bo_create(device, NULL, (uint64_t)wave_bytes * waves, 4096, RADEON_DOMAIN_VRAM,
+                         RADEON_FLAG_NO_INTERPROCESS_SHARING, RADV_BO_PRIORITY_SCRATCH, 0, true,
+                         &grown) == VK_SUCCESS) {
+         /* The previous buffer may still be in flight: it is kept. */
+         bo = grown;
+         bo_wave_bytes = wave_bytes;
+         bo_waves = waves;
+         fprintf(stderr, "radv/ps5: dispatch scratch: %u bytes a wave, %u waves\n", wave_bytes, waves);
+      }
+   }
+   struct radeon_winsys_bo *const use = bo;
+   const uint32_t wave_bytes = bo_wave_bytes, waves = bo_waves;
+   simple_mtx_unlock(&lock);
+   if (!use || wave_bytes < need)
+      return;
+   const uint64_t va = radv_buffer_get_va(use);
+   uint32_t tmpring_size;
+   ac_get_scratch_tmpring_size(&pdev->info, waves, wave_bytes, &tmpring_size);
+   radv_cs_add_buffer(device->ws, cs->b, use);
+   radeon_check_space(device->ws, cs->b, 8);
+   radeon_begin(cs);
+   radeon_set_sh_reg_seq(R_00B900_COMPUTE_USER_DATA_0, 2);
+   radeon_emit(va);
+   radeon_emit(S_008F04_BASE_ADDRESS_HI(va >> 32) | S_008F04_SWIZZLE_ENABLE_GFX6(1));
+   radeon_set_sh_reg(R_00B860_COMPUTE_TMPRING_SIZE, tmpring_size);
+   radeon_end();
+}
