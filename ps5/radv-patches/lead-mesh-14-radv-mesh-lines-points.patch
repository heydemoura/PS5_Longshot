+/* (lead-mesh-14) A mesh shader's primitive's vertices, and the copy's hardware topology for them. */
+static inline unsigned
+radv_mesh_compute_corners(unsigned mesa_prim)
+{
+   return mesa_prim == MESA_PRIM_LINES ? 2 : mesa_prim == MESA_PRIM_POINTS ? 1 : 3;
+}
+
+static inline unsigned
+radv_mesh_compute_topology(unsigned corners)
+{
+   return corners == 2 ? V_008958_DI_PT_LINELIST : corners == 1 ? V_008958_DI_PT_POINTLIST : V_008958_DI_PT_TRILIST;
+}
+
 /* The buffer's size: EDEN_NX2_RADV_MESH_COMPUTE_MIB (8 to 512), RADV_MESH_COMPUTE_BYTES unset. */
